{
    "name": "x-laravel/followable",
    "description": "Follows for Eloquent models with polymorphic followers, follow requests, mutual follows and cleanup of orphaned follows.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "eloquent", "follow", "followable", "followers", "polymorphic"],
    "authors": [
        {
            "name": "Mehmet ÖĞMEN",
            "email": "www@mehmetogmen.com.tr",
            "homepage": "https://www.mehmetogmen.com.tr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "XLaravel\\Followable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XLaravel\\Followable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XLaravel\\Followable\\FollowableServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
